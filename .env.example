# Copy to .env (never commit .env):  copy .env.example .env
# Read by the worker (worker/src/stdb.ts) and scripts/publish.ps1.

# SpacetimeDB on Maincloud
STDB_HOST=https://maincloud.spacetimedb.com
STDB_DB=legacy-data

# Your worker identity's token. Get it with `cd worker && npm run identity`,
# then have the database owner run the add_writer command it prints.
# Each person uses their own token; it is a password, don't share it.
STDB_TOKEN=

# NVIDIA_API_KEY does NOT go here. It is set in the database's Environment
# settings on spacetimedb.com and only read inside the module (ctx.env);
# the worker calls Nemotron through the nemotron_chat procedure.

# Dashboard (Vite only exposes VITE_* variables, and by default reads them
# from dashboard/.env, so copy these two lines there when the dashboard
# connects to SpacetimeDB).
VITE_STDB_URI=wss://maincloud.spacetimedb.com
VITE_STDB_DB=legacy-data
